            table.cell(nxs_hud, 1, row_idx, str.tostring(sym_line2_value, "#.00"), text_color=sln_hud_txt, text_size=sln_table_sz)
            table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz)
            row_idx += 1

        int sln_count = array.size(sln_prices)
        
        // --- 3. SPACER ROW (Between Macro & SLN) ---
        // Only render the spacer if there is at least one active macro level ABOVE it, and at least one SLN level BELOW it
        if row_idx > 1 and sln_count > 0
            table.cell(nxs_hud, 0, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz, bgcolor=color.new(color.black, 70))
            table.cell(nxs_hud, 1, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz, bgcolor=color.new(color.black, 70))
            table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz, bgcolor=color.new(color.black, 70))
            row_idx += 1
        
        // --- 4. DYNAMIC SLN LEVELS (LOWER HALF) ---
        if sln_count > 0
            // Freshest Level (Top of SLN block)
            float fresh_px = array.get(sln_prices, sln_count - 1)
            int fresh_tm = array.get(sln_times, sln_count - 1)
            int age_mins_f = math.max(0, math.round((timenow - fresh_tm) / 60000))
            string age_str_f = age_mins_f >= 60 ? str.tostring(math.floor(age_mins_f / 60)) + "h " + str.tostring(age_mins_f % 60) + "m" : str.tostring(age_mins_f) + "m"
            
            table.cell(nxs_hud, 0, row_idx, "SLN", text_color=sln_ln_color, text_size=sln_table_sz) 
            table.cell(nxs_hud, 1, row_idx, str.tostring(fresh_px, "#.00") + " / " + str.format_time(fresh_tm, "HH:mm", sym_tz), text_color=sln_hud_txt, text_size=sln_table_sz)
            table.cell(nxs_hud, 2, row_idx, age_str_f, text_color=sln_hud_txt, text_size=sln_table_sz)
            row_idx += 1
            
            int remaining = math.min(4, sln_count - 1)
            
            // --- NEW SPACER: Isolates Freshest SLN from Historical SLNs ---
            if remaining > 0
                table.cell(nxs_hud, 0, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz, bgcolor=color.new(color.black, 70))
                table.cell(nxs_hud, 1, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz, bgcolor=color.new(color.black, 70))
                table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz, bgcolor=color.new(color.black, 70))
                row_idx += 1
            
            // Sort remaining historical SLN levels
            float[] sort_px = array.new_float()
            int[] sort_tm = array.new_int()
            
            if remaining > 0
                for i = 1 to remaining
                    array.push(sort_px, array.get(sln_prices, sln_count - 1 - i))
                    array.push(sort_tm, array.get(sln_times, sln_count - 1 - i))
                
                if remaining > 1
                    for i = 0 to remaining - 2
                        for j = 0 to remaining - 2 - i
                            if array.get(sort_px, j) < array.get(sort_px, j + 1)
                                float temp_px = array.get(sort_px, j)
                                array.set(sort_px, j, array.get(sort_px, j + 1))
                                array.set(sort_px, j + 1, temp_px)
                                int temp_tm = array.get(sort_tm, j)
                                array.set(sort_tm, j, array.get(sort_tm, j + 1))
                                array.set(sort_tm, j + 1, temp_tm)
                
                for i = 0 to remaining - 1
                    float p_px = array.get(sort_px, i)
                    int p_tm = array.get(sort_tm, i)
                    int a_m = math.max(0, math.round((timenow - p_tm) / 60000))
                    string a_s = a_m >= 60 ? str.tostring(math.floor(a_m / 60)) + "h " + str.tostring(a_m % 60) + "m" : str.tostring(a_m) + "m"
                    
                    table.cell(nxs_hud, 0, row_idx, "SLN", text_color=color.new(sln_ln_color, 30), text_size=sln_table_sz)
                    table.cell(nxs_hud, 1, row_idx, str.tostring(p_px, "#.00") + " / " + str.format_time(p_tm, "HH:mm", sym_tz), text_color=sln_hud_txt, text_size=sln_table_sz)
                    table.cell(nxs_hud, 2, row_idx, a_s, text_color=sln_hud_txt, text_size=sln_table_sz)
                    row_idx += 1

