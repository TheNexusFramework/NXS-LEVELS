        line x_wick = na
        
        if sln_xray_en
            float top = math.max(sln_o, sln_c)
            float bot = math.min(sln_o, sln_c)
            int midTime = int((sln_tOpen + sln_tClose) / 2)
            
            x_box := box.new(sln_tOpen, top, sln_tClose, bot, xloc=xloc.bar_time, bgcolor=sln_xray_body_col, border_color=sln_xray_body_col, border_width=1)
            x_wick := line.new(midTime, sln_h, midTime, sln_l, xloc=xloc.bar_time, color=sln_xray_wick_col, width=2)
                
        array.push(sln_xray_boxes, x_box)
        array.push(sln_xray_wicks, x_wick)
