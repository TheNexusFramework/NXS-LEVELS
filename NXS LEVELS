        for i = 0 to array.size(sln_prices) - 1
            if math.abs(array.get(sln_prices, i) - sln_c) < (sln_c * 0.001)
                exists := true
                break
    
    if not exists
        int init_x2 = sln_dyn_ext ? bar_index : bar_index + sln_ln_len
        line new_ln = line.new(bar_index, sln_c, init_x2, sln_c, xloc=xloc.bar_index, color=sln_ln_color, width=sln_ln_width, style=line.style_solid)
        array.push(sln_lines, new_ln)
        array.push(sln_prices, sln_c)
        array.push(sln_times, time) 
        array.push(sln_alerts, -sln_cooldown)
        
