var sln_table_pos = sln_hud_pos == "Top Left" ? position.top_left : sln_hud_pos == "Top Center" ? position.top_center : sln_hud_pos == "Top Right" ? position.top_right : sln_hud_pos == "Middle Left" ? position.middle_left : sln_hud_pos == "Middle Center" ? position.middle_center : sln_hud_pos == "Middle Right" ? position.middle_right : sln_hud_pos == "Bottom Left" ? position.bottom_left : sln_hud_pos == "Bottom Center" ? position.bottom_center : position.bottom_right
var sln_table_sz = sln_hud_size == "Tiny" ? size.tiny : sln_hud_size == "Small" ? size.small : sln_hud_size == "Large" ? size.large : sln_hud_size == "Huge" ? size.huge : size.normal

// Initialized with 25 potential rows, but it will dynamically shrink based on populated data
var table nxs_hud = table.new(sln_table_pos, 3, 25, border_width=1, border_color=sln_hud_bord, bgcolor=sln_hud_bg)

if barstate.islast
    table.clear(nxs_hud, 0, 0, 2, 24) // Absolute wipe to prevent ANY ghosting or empty cell rendering
    if sln_hud_show
        // --- 1. HUD HEADERS ---
        table.cell(nxs_hud, 0, 0, "LEVEL", text_color=sln_hud_txt, text_size=sln_table_sz, bgcolor=color.new(color.black, 40))
        table.cell(nxs_hud, 1, 0, "PRICE / TIME", text_color=sln_hud_txt, text_size=sln_table_sz, bgcolor=color.new(color.black, 40))
        table.cell(nxs_hud, 2, 0, "ACTIVE", text_color=sln_hud_txt, text_size=sln_table_sz, bgcolor=color.new(color.black, 40))

        int row_idx = 1
        
        // --- 2. MACRO STRUCTURAL LEVELS (UPPER HALF) ---
        if show_hud_nyo and not na(sessionOpen)
            table.cell(nxs_hud, 0, row_idx, "NY-O", text_color=ny_open_color, text_size=sln_table_sz)
            table.cell(nxs_hud, 1, row_idx, str.tostring(sessionOpen, "#.00"), text_color=sln_hud_txt, text_size=sln_table_sz)
            table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz)
            row_idx += 1
        if show_hud_nyc and not na(sessionClose)
            table.cell(nxs_hud, 0, row_idx, "NY-C", text_color=ny_close_color, text_size=sln_table_sz)
            table.cell(nxs_hud, 1, row_idx, str.tostring(sessionClose, "#.00"), text_color=sln_hud_txt, text_size=sln_table_sz)
            table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz)
            row_idx += 1
        if show_hud_on and not na(on_high)
            table.cell(nxs_hud, 0, row_idx, "ON-H", text_color=on_h_color, text_size=sln_table_sz)
            table.cell(nxs_hud, 1, row_idx, str.tostring(on_high, "#.00"), text_color=sln_hud_txt, text_size=sln_table_sz)
            table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz)
            row_idx += 1
        if show_hud_on and not na(on_low)
            table.cell(nxs_hud, 0, row_idx, "ON-L", text_color=on_l_color, text_size=sln_table_sz)
            table.cell(nxs_hud, 1, row_idx, str.tostring(on_low, "#.00"), text_color=sln_hud_txt, text_size=sln_table_sz)
            table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz)
            row_idx += 1
        if show_hud_pc and not na(chart_prev_close)
            table.cell(nxs_hud, 0, row_idx, "P-C", text_color=pc_color, text_size=sln_table_sz)
            table.cell(nxs_hud, 1, row_idx, str.tostring(chart_prev_close, "#.00"), text_color=sln_hud_txt, text_size=sln_table_sz)
            table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz)
            row_idx += 1
        if show_hud_pd and not na(opt_pd_high)
            table.cell(nxs_hud, 0, row_idx, "PDH", text_color=opt_color_pdh, text_size=sln_table_sz)
            table.cell(nxs_hud, 1, row_idx, str.tostring(opt_pd_high, "#.00"), text_color=sln_hud_txt, text_size=sln_table_sz)
            table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz)
            row_idx += 1
        if show_hud_pd and not na(opt_pd_low)
            table.cell(nxs_hud, 0, row_idx, "PDL", text_color=opt_color_pdl, text_size=sln_table_sz)
            table.cell(nxs_hud, 1, row_idx, str.tostring(opt_pd_low, "#.00"), text_color=sln_hud_txt, text_size=sln_table_sz)
            table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz)
            row_idx += 1
            
        if show_hud_wk and not na(w_high)
            table.cell(nxs_hud, 0, row_idx, "W-H", text_color=w_h_color, text_size=sln_table_sz)
            table.cell(nxs_hud, 1, row_idx, str.tostring(w_high, "#.00"), text_color=sln_hud_txt, text_size=sln_table_sz)
            table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz)
            row_idx += 1
        if show_hud_wk and not na(w_low)
            table.cell(nxs_hud, 0, row_idx, "W-L", text_color=w_l_color, text_size=sln_table_sz)
            table.cell(nxs_hud, 1, row_idx, str.tostring(w_low, "#.00"), text_color=sln_hud_txt, text_size=sln_table_sz)
            table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz)
            row_idx += 1
            
        if show_hud_mo and not na(m_high)
            table.cell(nxs_hud, 0, row_idx, "M-H", text_color=m_h_color, text_size=sln_table_sz)
            table.cell(nxs_hud, 1, row_idx, str.tostring(m_high, "#.00"), text_color=sln_hud_txt, text_size=sln_table_sz)
            table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz)
            row_idx += 1
        if show_hud_mo and not na(m_low)
            table.cell(nxs_hud, 0, row_idx, "M-L", text_color=m_l_color, text_size=sln_table_sz)
            table.cell(nxs_hud, 1, row_idx, str.tostring(m_low, "#.00"), text_color=sln_hud_txt, text_size=sln_table_sz)
            table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz)
            row_idx += 1

        if show_hud_qr and not na(q_high)
            table.cell(nxs_hud, 0, row_idx, "Q-H", text_color=q_h_color, text_size=sln_table_sz)
            table.cell(nxs_hud, 1, row_idx, str.tostring(q_high, "#.00"), text_color=sln_hud_txt, text_size=sln_table_sz)
            table.cell(nxs_hud, 2, row_idx, "---", text_color=color.new(color.white, 50), text_size=sln_table_sz)
