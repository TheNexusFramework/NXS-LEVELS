    for i = 0 to array.size(sln_prices) - 1
        float p = array.get(sln_prices, i)
        int last_alert_bar = array.get(sln_alerts, i)
        
        if low <= p and high >= p
            if (bar_index - last_alert_bar) >= sln_cooldown
                if last_sln_alert_bar != bar_index
                    
                    // Trigger standard pop-up alert
                    if al_sln
                        alert("NXS SLN TAGGED: " + str.tostring(p, "#.00"), alert.freq_once_per_bar)
